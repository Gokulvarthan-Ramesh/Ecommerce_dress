{
	"info": {
		"_postman_id": "ecommerce-api-full-collection",
		"name": "Ecommerce API – Full Collection",
		"description": "Complete Postman collection for the Ecommerce REST API.\n\nBase URL: {{baseUrl}} (default http://localhost:5000)\n\n**Authentication**: Most endpoints require a Bearer token. After login/register, copy the token into the `authToken` collection variable. All authenticated folders inherit it automatically.\n\n**Admin endpoints**: Require an admin-role JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerId",
			"value": "4159f7e5-f4a1-47b5-b2cd-cbc5a57b8f70",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Returns API health status, timestamp, and service name."
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Send WhatsApp OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/send-otp",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "send-otp"]
						},
						"description": "Sends a 6-digit OTP to the given phone number via WhatsApp."
					}
				},
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('authToken', json.data.token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"password\": \"securePass123\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"referralCode\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Register a new user. OTP must be verified first via /send-otp. Optionally pass a referralCode. Auto-saves returned token."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('authToken', json.data.token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"9876543210\",\n  \"password\": \"securePass123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with phone/email and password. Auto-saves returned token to authToken variable."
					}
				},
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('adminToken', json.data.token);",
									"    pm.collectionVariables.set('authToken', json.data.token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"decodexfashionwear@gmail.com\",\n  \"password\": \"Admin@12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login as Administrator (seeded: decodexfashionwear@gmail.com / Admin@12345). Auto-saves the returned token into both adminToken and authToken collection variables."
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "profile"]
						},
						"description": "Get the authenticated user's profile details."
					}
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "Get All Categories (with Full Filters)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/categories?mainSlug=men&status=active&level=2&search=&hasProducts=&sort=sortOrder_asc&tree=false&grouped=false&page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categories"],
							"query": [
								{ "key": "mainSlug", "value": "men", "description": "Filter by main catalog: men, women, kids, or all", "disabled": true },
								{ "key": "status", "value": "active", "description": "Filter by status: active, inactive, or all (default: active)", "disabled": true },
								{ "key": "level", "value": "2", "description": "Filter by level: 1 (parent categories only: Men, Women, Kids), 2 (subcategories only)", "disabled": true },
								{ "key": "parentSlug", "value": "men", "description": "Filter subcategories directly under parent slug (e.g. men, women, kids)", "disabled": true },
								{ "key": "parentId", "value": "null", "description": "Filter by parent UUID, or 'null' for root categories only", "disabled": true },
								{ "key": "search", "value": "shirt", "description": "Search category by name, description, or slug", "disabled": true },
								{ "key": "hasProducts", "value": "true", "description": "Filter categories that have at least 1 product (true/false)", "disabled": true },
								{ "key": "sort", "value": "sortOrder_asc", "description": "Sort order: sortOrder_asc, sortOrder_desc, name_asc, name_desc, products_desc, newest, oldest", "disabled": true },
								{ "key": "tree", "value": "true", "description": "Return nested tree structure with subCategories under parent categories", "disabled": true },
								{ "key": "grouped", "value": "true", "description": "Group categories by main category ({ all, men, women, kids })", "disabled": true },
								{ "key": "page", "value": "1", "description": "Page number for pagination", "disabled": true },
								{ "key": "limit", "value": "20", "description": "Items per page for pagination", "disabled": true }
							]
						},
						"description": "List categories with comprehensive filtering:\n\n• `mainSlug`: 'men' | 'women' | 'kids' | 'all'\n• `status`: 'active' | 'inactive' | 'all'\n• `level`: 1 (parents) | 2 (subcategories)\n• `parentSlug`: 'men' | 'women' | 'kids'\n• `parentId`: UUID or 'null'\n• `search`: text search across name, description, slug\n• `hasProducts`: true | false\n• `sort`: 'sortOrder_asc' | 'name_asc' | 'products_desc' | 'newest'\n• `tree`: true (nested hierarchy)\n• `grouped`: true ({ all, men, women, kids })\n• `page` & `limit`: pagination metadata"
					}
				},
				{
					"name": "Get Category Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/categories/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categories", ":id"],
							"variable": [
								{ "key": "id", "value": "CATEGORY_ID_HERE", "description": "Category ID" }
							]
						},
						"description": "Get details for a specific category including its products."
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get Catalog Filters (Detailed Facets)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/filters?mainSlug=men",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", "filters"],
							"query": [
								{ "key": "mainSlug", "value": "men", "description": "Scope filters to department: 'men', 'women', 'kids', or 'all'", "disabled": true },
								{ "key": "category", "value": "men-tshirts", "description": "Scope filters to specific category or subcategory slug", "disabled": true }
							]
						},
						"description": "Returns full, dynamic e-commerce catalog filter facets:\n\n• `totalProducts`: Total matching active products\n• `departments`: [{ name, slug, count }]\n• `categories`: [{ id, name, slug, mainSlug, level, parent, productCount }]\n• `categoryTree`: 3-level hierarchy with product counts\n• `brands`: [{ name, count }]\n• `sizes`: [{ size, count }]\n• `colors`: [{ color, hex, count }]\n• `fabrics`: [{ name, count }]\n• `fits`: [{ name, count }]\n• `sleeves`: [{ name, count }]\n• `patterns`: [{ name, count }]\n• `price`: { min, max, avg }\n• `priceBuckets`: [{ label, min, max, count }]\n• `sortOptions`: [{ label, value }]"
					}
				},
				{
					"name": "Get Products (List with Deep Filters)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products?category=&mainSlug=&brand=&fabric=&fit=&sleeve=&pattern=&size=&color=&minPrice=&maxPrice=&inStock=true&isFeatured=&search=&sort=newest&page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products"],
							"query": [
								{ "key": "page", "value": "1", "description": "Page number (default 1)" },
								{ "key": "limit", "value": "20", "description": "Items per page (default 20)" },
								{ "key": "category", "value": "men-tshirts", "description": "Category slug (matches direct category, children, and grandchildren)", "disabled": true },
								{ "key": "mainSlug", "value": "men", "description": "Department filter: men, women, kids", "disabled": true },
								{ "key": "brand", "value": "ClassicLine,StyleCraft", "description": "Filter by brand name (comma-separated for multi-brand)", "disabled": true },
								{ "key": "fabric", "value": "Cotton,Linen", "description": "Filter by fabric (comma-separated)", "disabled": true },
								{ "key": "fit", "value": "Slim,Regular", "description": "Filter by fit: Slim, Regular, Oversized, etc.", "disabled": true },
								{ "key": "sleeve", "value": "Half Sleeve", "description": "Filter by sleeve type", "disabled": true },
								{ "key": "pattern", "value": "Solid,Striped", "description": "Filter by pattern", "disabled": true },
								{ "key": "size", "value": "M,L", "description": "Filter by size (comma-separated for multi-size)", "disabled": true },
								{ "key": "color", "value": "Black,Navy Blue", "description": "Filter by color (comma-separated)", "disabled": true },
								{ "key": "minPrice", "value": "500", "description": "Minimum selling price", "disabled": true },
								{ "key": "maxPrice", "value": "1500", "description": "Maximum selling price", "disabled": true },
								{ "key": "inStock", "value": "true", "description": "Only show products in stock (stockQuantity > 0)", "disabled": true },
								{ "key": "isFeatured", "value": "true", "description": "Only show featured products", "disabled": true },
								{ "key": "search", "value": "shirt", "description": "Search by product name, description, brand", "disabled": true },
								{ "key": "sort", "value": "newest", "description": "Sort order: 'newest', 'price_asc', 'price_desc', 'name_asc', 'name_desc'", "disabled": true }
							]
						},
						"description": "Get paginated products with full e-commerce filtering across categories, departments, brands, fabrics, fits, sleeves, patterns, sizes, colors, price ranges, in-stock status, and sorting."
					}
				},
				{
					"name": "Get Product Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/products/:identifier",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "products", ":identifier"],
							"variable": [
								{ "key": "identifier", "value": "PRODUCT_ID_OR_SLUG", "description": "Product ID or slug" }
							]
						},
						"description": "Get full product details by ID or slug, including variants and images."
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/cart",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cart"]
						},
						"description": "Get the current user's cart with items, variants, and totals."
					}
				},
				{
					"name": "Add Item to Cart",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"variantId\": \"VARIANT_ID_HERE\",\n  \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cart/items",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cart", "items"]
						},
						"description": "Add a product variant to the cart. Quantity defaults to 1 if not specified."
					}
				},
				{
					"name": "Update Cart Item Quantity",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/cart/items/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cart", "items", ":id"],
							"variable": [
								{ "key": "id", "value": "CART_ITEM_ID_HERE", "description": "Cart Item ID" }
							]
						},
						"description": "Update the quantity of a specific cart item. Setting quantity to 0 removes the item."
					}
				},
				{
					"name": "Remove Item from Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/cart/items/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cart", "items", ":id"],
							"variable": [
								{ "key": "id", "value": "CART_ITEM_ID_HERE", "description": "Cart Item ID" }
							]
						},
						"description": "Remove a specific item from the cart."
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/cart",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "cart"]
						},
						"description": "Remove all items from the cart."
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Preview Checkout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [],\n  \"couponCode\": \"\",\n  \"useWallet\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/preview",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", "preview"]
						},
						"description": "Preview checkout calculation — returns item totals, applicable discounts, shipping cost, wallet deduction, and final payable amount. Send empty items array to use cart contents."
					}
				},
				{
					"name": "Create Order (Checkout)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentMethod\": \"CASHFREE\",\n  \"useWallet\": false,\n  \"couponCode\": \"\",\n  \"shippingAddress\": {\n    \"fullName\": \"John Doe\",\n    \"phone\": \"9876543210\",\n    \"addressLine1\": \"123 Main Street\",\n    \"addressLine2\": \"Apt 4B\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"postalCode\": \"400001\",\n    \"country\": \"India\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/checkout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", "checkout"]
						},
						"description": "Place an order. paymentMethod can be 'CASHFREE' (online) or 'COD'. For Cashfree, a payment session URL is returned. useWallet: true applies wallet balance."
					}
				},
				{
					"name": "Get My Orders",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders"]
						},
						"description": "List all orders for the authenticated user."
					}
				},
				{
					"name": "Get Order Details",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", ":id"],
							"variable": [
								{ "key": "id", "value": "ORDER_ID_HERE", "description": "Order ID" }
							]
						},
						"description": "Get detailed information for a specific order. Automatically verifies and synchronizes Cashfree payment status if pending."
					}
				},
				{
					"name": "Verify / Sync Order Payment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/:id/verify",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", ":id", "verify"],
							"variable": [
								{ "key": "id", "value": "7305c02b-56af-41af-87a1-1f145be5e1b8", "description": "Order ID to verify" }
							]
						},
						"description": "Explicitly verify and synchronize payment status directly with Cashfree's API. Updates order to CONFIRMED and paymentStatus to SUCCESS upon verification."
					}
				},
				{
					"name": "Cancel Order",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Changed my mind\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/orders/:id/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "orders", ":id", "cancel"],
							"variable": [
								{ "key": "id", "value": "ORDER_ID_HERE", "description": "Order ID" }
							]
						},
						"description": "Cancel an order (allowed only before shipping). Payments and wallet amounts are refunded automatically."
					}
				}
			]
		},
