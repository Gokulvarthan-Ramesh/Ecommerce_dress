		{
			"name": "Referrals",
			"item": [
				{
					"name": "Get My Referral Info",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/referrals",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "referrals"]
						},
						"description": "Get the authenticated user's referral code, total earned, successful/pending referrals, and detailed referral list."
					}
				},
				{
					"name": "Validate Referral Code",
