		{
			"name": "Admin",
			"description": "All admin endpoints require an admin-role JWT. Set the `adminToken` variable after logging in as an admin user.",
			"item": [
				{
					"name": "Authentication",
					"item": [
						{
							"name": "Admin Login",
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"var json = pm.response.json();",
											"if (json.data && json.data.token) {",
											"    pm.collectionVariables.set('adminToken', json.data.token);",
											"    pm.collectionVariables.set('authToken', json.data.token);",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"identifier\": \"decodexfashionwear@gmail.com\",\n  \"password\": \"Admin@12345\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/v1/auth/login",
									"host": ["{{baseUrl}}"],
									"path": ["api", "v1", "auth", "login"]
								},
								"description": "Authenticate as an Administrator (decodexfashionwear@gmail.com). Automatically saves the admin JWT token into both adminToken and authToken collection variables for subsequent Admin API requests."
							}
						}
					]
				},
