# =============================================================================
# DecodeX E-Commerce Platform — Environment Template (.env.example)
# Copy this file to '.env' and fill in your confidential credentials.
# =============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL="http://localhost:5000"

# 2. Database (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce_db?schema=public"

# 3. Security & JWT Authentication
JWT_SECRET="your_jwt_super_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
SHOW_DEV_OTP=false

# 4. Cashfree Payment Gateway (PG v2023-08-01)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"
CASHFREE_ENV="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"

# 5. Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 6. Google Drive Storage (Optional / Alternate CDN)
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"
GOOGLE_DRIVE_CLIENT_EMAIL="your_service_account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 7. WhatsApp Business Cloud API (Meta) — Leave blank for local console simulator
WHATSAPP_API_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_ID="your_meta_phone_number_id"
WHATSAPP_OTP_TEMPLATE="your_approved_otp_template_name"

# 8. Frontend & Admin URLs (CORS & Redirections)
CUSTOMER_APP_URL="exp://localhost:8081"
ADMIN_PANEL_URL="http://localhost:5173"

# 9. Brand & Store Information
BRAND_NAME="DecodeX Fashionwear"
BRAND_EMAIL="decodexfashionwear@gmail.com"
BRAND_PHONE="9999999999"

# 10. Initial Database Seed Credentials (Admin & Customer)
INITIAL_ADMIN_EMAIL="admin@yourbrand.com"
INITIAL_ADMIN_PASSWORD="ChangeMe@Admin123"
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_PHONE="9999999999"

INITIAL_CUSTOMER_EMAIL="customer@yourbrand.com"
INITIAL_CUSTOMER_PASSWORD="ChangeMe@Cust123"
INITIAL_CUSTOMER_PHONE="9876543210"
