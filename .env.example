PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce_db?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_change_me
JWT_EXPIRES_IN=7d

# Cashfree Payments
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX

# Cloudinary Media
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# WhatsApp Business / Cloud API (Optional - Leave blank for local console simulator)
WHATSAPP_API_TOKEN=your_meta_system_user_or_user_access_token
WHATSAPP_PHONE_ID=your_meta_phone_number_id
WHATSAPP_OTP_TEMPLATE=your_approved_otp_template_name

# Client URLs
CUSTOMER_APP_URL=exp://localhost:8081
ADMIN_PANEL_URL=http://localhost:5173

# Brand Details
BRAND_NAME="DecodeX Fashionwear"
BRAND_EMAIL=decodexfashionwear@gmail.com

