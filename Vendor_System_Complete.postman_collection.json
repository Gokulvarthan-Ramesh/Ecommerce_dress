{
	"info": {
		"_postman_id": "vendor-system-separate-auth-v3",
		"name": "🏪 Vendor System — Complete A-Z Collection",
		"description": "Full vendor system with SEPARATE vendor authentication.\nVendors register and login independently from customers.\n\nFlow:\n1. Vendor Register (OTP) → vendorToken\n2. Create Application (DRAFT)\n3. Fill: Documents + Bank + Pickup Address\n4. Submit for Review\n5. Admin Approves → Shop Created\n6. Vendor manages Shop/Products/Orders/Payouts\n\nTokens:\n- vendorToken = Vendor JWT (type: VENDOR)\n- adminToken = Admin JWT (from /auth/admin/login)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
		{ "key": "vendorToken", "value": "" },
		{ "key": "adminToken", "value": "" },
		{ "key": "applicationId", "value": "" },
		{ "key": "documentId", "value": "" },
		{ "key": "bankAccountId", "value": "" },
		{ "key": "pickupAddressId", "value": "" },
		{ "key": "shopId", "value": "" },
		{ "key": "productId", "value": "" },
		{ "key": "subOrderId", "value": "" },
		{ "key": "payoutId", "value": "" },
		{ "key": "serviceAreaId", "value": "" }
	],
	"item": [
		{
			"name": "🔐 1. Vendor Auth (Separate from Customer)",
			"description": "Vendors have their own VendorUser table. Register/login via Phone + OTP.\nNo customer account needed. JWT token includes type='VENDOR'.",
			"item": [
				{
					"name": "1.1 Send Register OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/register/send-otp",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "register", "send-otp"]
						},
						"description": "Send OTP for vendor registration. Fails if phone already registered as vendor."
					}
				},
				{
					"name": "1.2 Register Vendor (OTP + Name)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('vendorToken', json.data.token);",
									"    console.log('✅ vendorToken saved');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\",\n  \"otp\": \"123456\",\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@fashion.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "register"]
						},
						"description": "Register new VendorUser. Creates record in vendor_users table.\nReturns JWT with { type: 'VENDOR' }.\nVendorUser status = PENDING until admin approves."
					}
				},
				{
					"name": "1.3 Send Login OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/login/send-otp",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "login", "send-otp"]
						},
						"description": "Send OTP for vendor login. Fails if phone not registered as vendor."
					}
				},
				{
					"name": "1.4 Login Vendor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('vendorToken', json.data.token);",
									"    console.log('✅ vendorToken saved');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "login"]
						},
						"description": "Login existing vendor. Returns JWT with { type: 'VENDOR' }."
					}
				},
				{
					"name": "1.5 Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/resend-otp",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "resend-otp"]
						},
						"description": "Resend OTP. Rate limited to 60 seconds."
					}
				},
				{
					"name": "1.6 Get Vendor Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "profile"]
						},
						"description": "Returns vendor profile with application status and shop list."
					}
				},
				{
					"name": "1.7 Update Vendor Profile",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Rahul K Sharma\",\n  \"email\": \"rahul.updated@fashion.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "profile"]
						},
						"description": "Update vendor name and email."
					}
				}
			]
		},
		{
			"name": "🚀 1B. Register Vendor + Shop (One-Shot)",
			"description": "One API call: Send OTP → Register with all shop details.\nNo bearer token needed. Creates VendorUser + Shop (PENDING_VERIFICATION).",
			"item": [
				{
					"name": "1B.1 Send Register OTP",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/auth/register/send-otp",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "auth", "register", "send-otp"]
						},
						"description": "Step 1: Send OTP to vendor phone."
					}
				},
				{
					"name": "1B.2 Register Vendor + Create Shop",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('vendorToken', json.data.token);",
									"    console.log('✅ vendorToken saved');",
									"}",
									"if (json.data && json.data.shop && json.data.shop.id) {",
									"    pm.collectionVariables.set('shopId', json.data.shop.id);",
									"    console.log('✅ shopId saved: ' + json.data.shop.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"8888888888\",\n  \"otp\": \"123456\",\n  \"ownerName\": \"Rahul Sharma\",\n  \"email\": \"rahul@fashion.com\",\n  \"name\": \"My Awesome Boutique\",\n  \"description\": \"Best clothing in town!\",\n  \"latitude\": 19.0760,\n  \"longitude\": 72.8777,\n  \"businessEmail\": \"vendor@business.com\",\n  \"businessPhone\": \"9876543210\",\n  \"supportPhone\": \"9876543210\",\n  \"addressLine\": \"123 Market St\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"gstin\": \"27AAAAA0000A1Z5\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"bankAccountNumber\": \"1234567890\",\n  \"bankIfsc\": \"HDFC0001234\",\n  \"bankBeneficiaryName\": \"John Doe\",\n  \"logoUrl\": \"https://example.com/logo.png\",\n  \"bannerUrl\": \"https://example.com/banner.png\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/register",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "register"]
						},
						"description": "Step 2: Register vendor + create shop in one call.\nRequired: phone, otp, ownerName, name (shop name).\nAll other fields are optional.\nReturns: vendorToken + shop (PENDING_VERIFICATION)."
					}
				}
			]
		},
		{
			"name": "📝 2. Vendor Application (Multi-Step Onboarding)",
			"description": "Create and manage vendor application. Requires vendorToken.\nApplication has 5 steps: Basic Info → Business Info → Documents → Bank → Pickup Address.\nSubmit when ready → Admin reviews.",
			"item": [
				{
					"name": "2.1 Create Application (DRAFT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.id) {",
									"    pm.collectionVariables.set('applicationId', json.data.id);",
									"    console.log('✅ applicationId saved: ' + json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ownerName\": \"Rahul Sharma\",\n  \"shopName\": \"Rahul's Men Fashion\",\n  \"businessEmail\": \"rahul@fashion.com\",\n  \"businessPhone\": \"8888888888\",\n  \"description\": \"Premium menswear store — formal shirts, casual wear, and accessories\",\n  \"businessType\": \"INDIVIDUAL\",\n  \"gstin\": \"27AAAAA0000A1Z5\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"shopLogoUrl\": \"https://example.com/logo.png\",\n  \"shopBannerUrl\": \"https://example.com/banner.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application"]
						},
						"description": "Creates application in DRAFT status. One application per vendor.\nRequired fields: ownerName, shopName.\nAll other fields are optional at this stage."
					}
				},
				{
					"name": "2.2 Get My Application (with completion %)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application"]
						},
						"description": "Returns full application with documents, bank, address, and completionStatus.\ncompletionStatus shows: steps completed, percentage, isReadyToSubmit."
					}
				},
				{
					"name": "2.3 Update Application",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"shopName\": \"Rahul's Premium Fashion\",\n  \"description\": \"Updated: Premium menswear — shirts, trousers, blazers & accessories\",\n  \"businessType\": \"PARTNERSHIP\",\n  \"gstin\": \"27BBBBB0000B1Z5\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application"]
						},
						"description": "Only allowed when status is DRAFT or CHANGES_REQUESTED.\nSend only the fields you want to update."
					}
				},
				{
					"name": "2.4 Upload Document — PAN Card",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.id) {",
									"    pm.collectionVariables.set('documentId', json.data.id);",
									"    console.log('✅ documentId saved: ' + json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"docType\": \"PAN_CARD\",\n  \"fileUrl\": \"https://storage.example.com/kyc/pan-card-rahul.jpg\",\n  \"fileName\": \"pan-card-rahul.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents"]
						},
						"description": "Upload KYC document. docType values: PAN_CARD, GST_CERTIFICATE, AADHAAR, CANCELLED_CHEQUE.\nfileUrl should be a URL to the uploaded file (use your file upload endpoint first)."
					}
				},
				{
					"name": "2.5 Upload Document — GST Certificate",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"docType\": \"GST_CERTIFICATE\",\n  \"fileUrl\": \"https://storage.example.com/kyc/gst-cert-rahul.pdf\",\n  \"fileName\": \"gst-certificate.pdf\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents"]
						}
					}
				},
				{
					"name": "2.6 Upload Document — Aadhaar",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"docType\": \"AADHAAR\",\n  \"fileUrl\": \"https://storage.example.com/kyc/aadhaar-rahul.jpg\",\n  \"fileName\": \"aadhaar-front.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents"]
						}
					}
				},
				{
					"name": "2.7 Upload Document — Cancelled Cheque",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"docType\": \"CANCELLED_CHEQUE\",\n  \"fileUrl\": \"https://storage.example.com/kyc/cheque-rahul.jpg\",\n  \"fileName\": \"cancelled-cheque.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents"]
						}
					}
				},
				{
					"name": "2.8 List My Documents",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents"]
						}
					}
				},
				{
					"name": "2.9 Delete Document (PENDING only)",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application/documents/{{documentId}}",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "documents", "{{documentId}}"]
						},
						"description": "Can only delete documents in PENDING status. Verified/rejected docs cannot be deleted."
					}
				},
				{
					"name": "2.10 Save Bank Account",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.id) {",
									"    pm.collectionVariables.set('bankAccountId', json.data.id);",
									"    console.log('✅ bankAccountId saved: ' + json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"accountNumber\": \"50100123456789\",\n  \"ifsc\": \"HDFC0001234\",\n  \"beneficiaryName\": \"Rahul Sharma\",\n  \"bankName\": \"HDFC Bank\",\n  \"branchName\": \"Andheri West, Mumbai\",\n  \"accountType\": \"SAVINGS\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/bank-account",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "bank-account"]
						},
						"description": "Add or update bank account. Upsert operation.\nRequired: accountNumber, ifsc, beneficiaryName.\nOptional: bankName, branchName, accountType (SAVINGS/CURRENT).\nOnly allowed when DRAFT or CHANGES_REQUESTED."
					}
				},
				{
					"name": "2.11 Get My Bank Account",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application/bank-account",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "bank-account"]
						}
					}
				},
				{
					"name": "2.12 Save Pickup Address (with lat/lng)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.id) {",
									"    pm.collectionVariables.set('pickupAddressId', json.data.id);",
									"    console.log('✅ pickupAddressId saved: ' + json.data.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"contactName\": \"Rahul Sharma\",\n  \"contactPhone\": \"8888888888\",\n  \"addressLine\": \"Shop 12, Fashion Street, Andheri West\",\n  \"landmark\": \"Near Andheri Metro Station\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400058\",\n  \"country\": \"India\",\n  \"latitude\": 19.1364,\n  \"longitude\": 72.8296\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/vendor/application/pickup-address",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "pickup-address"]
						},
						"description": "Add or update pickup address. Upsert operation.\nRequired: addressLine, city, state, pincode, latitude, longitude.\nOptional: contactName, contactPhone, landmark, country.\nOnly allowed when DRAFT or CHANGES_REQUESTED."
					}
				},
				{
					"name": "2.13 Get My Pickup Address",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application/pickup-address",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "pickup-address"]
						}
					}
				},
				{
					"name": "2.14 Submit Application for Review ✈️",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{vendorToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/vendor/application/submit",
							"host": ["{{baseUrl}}"],
							"path": ["vendor", "application", "submit"]
						},
						"description": "Submit application for admin review.\nRequires: ownerName, shopName, bankAccount, pickupAddress.\nStatus changes: DRAFT/CHANGES_REQUESTED → SUBMITTED."
					}
				}
			]
		},
		{
			"name": "🛡️ 3. Admin — Application Review & Verification",
			"description": "Admin endpoints for reviewing vendor applications.\nUses adminToken (from admin login system).",
			"item": [
				{
					"name": "3.1 List All Applications (with filters)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/admin/vendor-applications?status=SUBMITTED&page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "vendor-applications"],
							"query": [
								{ "key": "status", "value": "SUBMITTED", "description": "Filter: DRAFT, SUBMITTED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED, SUSPENDED, DEACTIVATED" },
								{ "key": "search", "value": "", "disabled": true, "description": "Search by ownerName, shopName, email, phone" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" }
							]
						},
